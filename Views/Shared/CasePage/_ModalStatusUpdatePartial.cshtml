@using CCIMS.Web.App_Code._Globals.Constants
@using CCIMS.Web.Models.ViewModels
@using CCIMS.Web.Models.ViewModels.Partials
@using CCIMS.Web.App_Code._Globals.Extensions

@{

	var currStatus = new InputFieldViewModel()
		{
			OperationName = "edit",
			IdName = "currStat",
			IsDisabled = true,
			Title = "Current Status",
			ClassName = "col",
			InputClassName = "bg-gray-200"
		};

	var comments = new InputFieldViewModel()
		{
			OperationName = "edit",
			IdName = "comments",
			Title = "Comments / Remarks",
			ClassName = "col",
		};

	var status = new SelectViewModel()
			{
				OperationName = "edit",
				IdName = "stats",
				Title = "Status",
				InputContainerClassName = "col"
			};

}


<!-- Update Status -->
<div class="modal fade" id="modal-update-stat" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
	<form id="form-update-stat">
		<div class="modal-dialog">
			<div class="modal-content p-2">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="staticBackdropLabel">Change Status</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<div class="p-4	">
						<div class="row">
							@await Html.RenderAsync(currStatus)
						</div>
						<div class="row">
							@await Html.RenderAsync(status)
						</div>
						<div class="row">
							@await Html.RenderAsync(comments)
						</div>
					</div>
				</div>

				<input type="hidden" id="hdn-update-caseId" />

				<div class="modal-footer">
					<button type="button" class="mx-2 col btn border-1 btn-outline-secondary" data-bs-dismiss="modal">Close</button>
					<button type="submit" class="mx-2 col btn border-1 btn-primary">Update</button>
				</div>
			</div>
		</div>
	</form>
</div>

<script type="module">
	import { initModal as init, onEdit } from '/js/components/caseStatusModalUpdate.js';

	window.showEdit = onEdit
	
	const statusChoice = new Choices(document.getElementById('@status.Id'), {
		searchEnabled: false
	});

	init('@currStatus.Id', statusChoice, '@status.Id', '@comments.Id', 'hdn-update-caseId');


</script>
