@using CCIMS.Web.Models.ViewModels

@model IEnumerable<CaseTransactionsViewModel>

<div class="card blur shadow-blur overflow-auto overflow-x-hidden mb-5 mb-lg-0">
  <div class="card-header pb-0">
    <h6>Transactions Timeline</h6>
  </div>
  <div class="card-body p-3">
    <div class="timeline timeline-one-side" data-timeline-axis-style="dotted">
      @{
        int x = 0;
        foreach (var transaction in Model)
        {
          <div class="timeline-block mb-3">
            <span class="timeline-step">
              @if(x <= 0)
              {
                <i class="ni ni-bell-55 text-success text-gradient"></i>
              }
              else
              {
                <i class="ni ni-check-bold text-success text-gradient"></i>
              }
            </span>
            <div class="timeline-content">
              <h6 class="text-dark text-sm font-weight-bold mb-0">@transaction.StatusName</h6>
              <p class="text-secondary font-weight-bold text-xs mt-1 mb-0">@transaction.TransactionDate</p>
              <p class="text-sm mt-3 mb-2">
                @transaction.Comments
              </p>
              <span class="badge badge-sm bg-gradient-success"  data-bs-toggle="tooltip" data-bs-placement="top" title="Transaction ID">#@transaction.TransactionId</span>
            </div>
          </div>

          x++;
        }
      }
    </div>
  </div>
</div>