@using CCIMS.Web.Models.ViewModels
@model CaseRowViewModel

<tr data-case-id="@Model.Id">
  <td class="align-middle">
    @if(User.IsInRole("SPA"))
    {
      <button 
        class="btn btn-transparent p-0 ms-3"
        data-bs-toggle="modal"
        data-bs-target="#modal-update-stat"
        onclick="window.showEdit(this)">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
          <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
          <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
        </svg>
      </button>
    }
    else
    {
      <a class="btn btn-transparent p-0 ms-3" asp-action="Update" asp-controller="Cases" asp-route-id="@Model.Id">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
          <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
          <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
        </svg>
      </a>
    }
  </td>

  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.CaseNumber</p>
  </td>

  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.Status</p>
  </td>

  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.Comments</p>
  </td>

  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.CustomerName</p>
  </td>
  
  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.ServicePartnerName</p>
  </td>
  
  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.SerialNumber</p>
  </td>
  
  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.DateCreated</p>
  </td>  

  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.DateUpdated</p>
  </td>
  
  <td>
    <p class="text-xs font-weight-bold ms-0">@Model.DaysAged</p>
  </td>
</tr>
