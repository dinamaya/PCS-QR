@using CCIMS.Web.App_Code._Globals.Constants
@using CCIMS.Web.Models.ViewModels
@using CCIMS.Web.Models.ViewModels.Partials
@using CCIMS.Web.App_Code._Globals.Extensions

@model string

@{
	var fname = new InputFieldViewModel()
			{
				OperationName = "edit",
				IdName = "fname",
				Title = "First Name",
				ClassName = "col"
			};

	var lname = new InputFieldViewModel()
			{
				OperationName = "edit",
				IdName = "lname",
				Title = "Last Name",
				ClassName = "col-12 col-md-6 "
			};

	var email = new InputFieldViewModel()
			{
				OperationName = "edit",
				IdName = "email",
				Title = "Email Address",
				ClassName = "col-12 col-md-6 ",
				Type = CCIMS.Web.App_Code._Globals.Enums.InputType.Email
			};

	var contact = new InputFieldViewModel()
			{
				OperationName = "edit",
				IdName = "contact",
				Title = "Contact Number",
				ClassName = "col-12 col-md-6 ",
			};
			
	var address = new InputFieldViewModel()
			{
				OperationName = "edit",
				IdName = "address",
				Title = "Address",
				ClassName = "col-12 ",
			};

}


<!-- Edit Customer -->
<div class="modal modal-xl fade" id="modal-edit-customer" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
	<form id="form-edit-customer">
		<div class="modal-dialog">
			<div class="modal-content p-2">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="staticBackdropLabel">Edit Customer</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<div class="p-4	">

						<div class="row">
							@await Html.RenderAsync(fname)
							@await Html.RenderAsync(lname)
						</div>
						
						<div class="row">
							@await Html.RenderAsync(contact)
							@await Html.RenderAsync(email)
						</div>

						<div class="row">
							@await Html.RenderAsync(address)
						</div>

					</div>
				</div>

				<input type="hidden" id="hdn-edit-custId" value="@Model" />

				<div class="modal-footer">
					<button type="button" class="mx-2 col btn border-1 btn-outline-secondary" data-bs-dismiss="modal">Close</button>
					<button type="submit" class="mx-2 col btn border-1 bg-gradient-primary">Edit</button>
				</div>
			</div>
		</div>
	</form>
</div>

<script type="module">
	import { initModal as initEditModal, initModalNotifs as initEditNotifs } from '/js/components/customerModalEdit.js';
	initEditModal('@lname.Id', '@fname.Id', '@email.Id', '@contact.Id', '@address.Id', 'hdn-edit-custId');
	initEditNotifs('@lname.NotifId', '@fname.NotifId', '@email.NotifId', '@contact.NotifId', '@address.NotifId');
</script>
