<div class="modal modal-xl fade" id="modal-edit-img" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content p-2">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="staticBackdropLabel">Edit Scanned Image</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body p-2 text-center">
        <div>
          <p class="font-weight-bolder">"Tip: Select only the part of the image that shows the Serial Number to improve accuracy."</p>
        </div>
				<div style="width: 100%; height: 100%; max-height: 80vh; min-height: 30rem; overflow: auto;">
					<img id="img-preview" class="img-fluid" style="max-width: 100%; height: 100%; width: 100%;" />
				</div>
			</div>

			<div class="modal-footer">
				<button type="button" class="mx-2 col btn border-1 btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="mx-2 col btn border-1 btn-primary" id="btn-send" onclick="uploadCroppedImage()">Crop</button>
			</div>
		</div>
	</div>
</div>

<script>
  function uploadCroppedImage() {
    if (!cropper) {
      console.error("Cropper not initialized.");
      return;
    }

    const canvas = cropper.getCroppedCanvas();

    canvas.toBlob(function (blob) {
      const formData = new FormData();
      formData.append("file", blob, "cropped.png");

      fetch("@Url.Content("/api/ocr/recognize")", {
        method: "POST",
        body: formData
      })
        .then(response => response.json())
        .then(data => {
          document.getElementById("txt-sn").value = data.result;
          modal.hide();
        })
        .catch(error => {
          console.error("Upload error:", error);
        });
    }, "image/png");
  }

</script>