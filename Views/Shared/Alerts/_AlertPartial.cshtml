@using CCIMS.Web.App_Code._Globals.Enums
@using CCIMS.Web.Models.ViewModels.Partials
@model AlertViewModel
@{
	Func<string> getAlertType = () => Model.Type switch
	{
		AlertType.Error => "alert-danger",
		AlertType.Primary => "alert-primary",
		AlertType.Success => "alert-success",
		AlertType.Warning => "alert-warning",
		_ => "alert-secondary"
	};

	string className = "p-2 px-3 mb-2 alert text-white text-start d-flex rounded-3 border-0 alert-dismissible " + getAlertType();
}

<div class="@className">
	<i class="fa-solid fa-circle-exclamation flex-shrink-0 me-2 pt-1"></i>
	<div class="flex-grow-1">
		@Model.Message
	</div>
	<button type="button" class="bg-transparent text-white border-0 flex-shrink-0 p-0 opacity-10" data-bs-dismiss="alert" aria-label="Close">
		<i class="fa-solid fa-xmark"></i>
	</button>
</div>