@using CCIMS.Web.App_Code._Globals
@using CCIMS.Web.Models.DTOs
@using CCIMS.Web.Models.ViewModels

@model CustomerEmailAssetsViewModel
<style>
	@@media (prefers-color-scheme: dark) 
	{
		body, html
		{
			background-color: #ffffff !important;
			color: #000000 !important;
		}

		img {
			filter: none !important;
		}

		.force-light {
			background-color: #ffffff !important;
			color: #000000 !important;
			filter: none !important;
		}

	}
</style>

<div class="force-light" style="
	padding-right: 3rem !important;
	padding-left: 3rem !important;
	margin-right: 3rem !important;
	margin-left: 3rem !important;
	max-width: 1320px !important;
	background: #f8f9fa !important;
">
	<div>
		<div style="
			display: flex !important;
			justify-content: space-between !important;
			align-items: center !important;
			padding-top: 1.5rem !important;
			padding-bottom: 1rem !important;
			">
			<a href="@Model.BaseUrl.AbsoluteUri" target="_blank">
				<img src="@Model.WebIcon" alt="main_logo" height="60">
			</a>
			<img src="@Model.VstIcon" height="80" />
		</div>
		<div >
			<div style="height: 100% !important; border: 4px solid #cb0c9f !important;"></div>
		</div>
	</div>
	<table style="width: 100%;">
		<tr>
			<td style="
				padding-right: 3rem !important;
				padding-left: 3rem !important;">
				<div style="
					margin-top: 3rem !important;
					background-image: linear-gradient(310deg, #141727 0%, #3A416F 100%)!important;
					border-radius: 1.5rem;">
					<div style="padding: 3rem !important;">
						<div style="width: 100%!important">
							<div style="text-align: center!important; vertical-align: -.1875em; width: 50px!important">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
									<path fill="#82d616" d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM369 209L241 337c-9.4 9.4-24.6 9.4-33.9 0l-64-64c-9.4-9.4-9.4-24.6 0-33.9s24.6-9.4 33.9 0l47 47L335 175c9.4-9.4 24.6-9.4 33.9 0s9.4 24.6 0 33.9z" />
								</svg>
							</div>
						</div>

						<h1 class="text-white text-center">Thank you for submitting your case!</h1>
					</div>
				</div>
			</td>
		</tr>
		<tr>
			<td>
				<h5 class="container px-5 text-dark pt-5 text-center">Our team will review the details and take the necessary steps as soon as possible.</h5>
			</td>
		</tr>
		<tr>
			<td>
				<h5 class="container px-5 text-dark text-center">If any additional information is required, we will reach out to you.</h5>
			</td>
		</tr>
	</table>
@* 	<div class="row px-4">
		
		
	</div> *@
	<div class="row mt-5">
		<div class="col-6">
			<img class="w-100 h-100" src="@Model.CharacterImage" alt="illustration-character-speech-thankyou">
		</div>
		<div class="col-6 mt-5 ps-4">
			<h2 class="fw-bolder border-5 border-start border-primary ps-3 mb-4">Case Summary</h2>
			<div class="ms-4">
				<h5>Case Number: <b class="ms-2 letter-spacing-2">@Model.CaseNumber</b></h5>
				<h5>Fullname: <b class="ms-2">@Model.Fullname</b></h5>
				<h5>Service Partner:  <b class="ms-2">@Model.ServicePartner</b></h5>
				<a class="btn bg-gradient-primary w-auto px-5 mt-4" target="_blank" href="@Model.CaseTrackingLink">View My Case</a>
			</div>
		</div>
	</div>
</div>

<hr />

<div class="container px-5 mx-5">
	<div>
		<div class="d-flex justify-content-between align-items-center pt-4 pb-3">
			<a href="@Model.BaseUrl.AbsoluteUri" target="_blank">
				<img src="@Model.WebIcon" alt="main_logo" height="60">
			</a>
			<img src="@Model.VstIcon" height="80" />
		</div>
		<div class="row">
			<div class="border-4 border-bottom border-primary h-100"></div>
		</div>
	</div>
	<div class="row px-4">
		<div class="bg-gradient-dark mt-5 h-auto border-radius-2xl position-relative">
			<div class="p-5">
				<div class="text-center">
					<i class="fa-solid fa-circle-check fa-2xl h1 text-success"></i>
				</div>
				<h1 class="text-white text-center">Thank you for submitting your case!</h1>
			</div>
		</div>
		<h5 class="container px-5 text-dark pt-5 text-center">Our team will review the details and take the necessary steps as soon as possible.</h5>
		<h5 class="container px-5 text-dark text-center">If any additional information is required, we will reach out to you.</h5>
	</div>
	<div class="row mt-5">
		<div class="col-6">
			<img class="w-100 h-100" src="@Model.CharacterImage" alt="illustration-character-speech-thankyou">
		</div>
		<div class="col-6 mt-5 ps-4">
			<h2 class="fw-bolder border-5 border-start border-primary ps-3 mb-4">Case Summary</h2>
			<div class="ms-4">
				<h5>Case Number: <b class="ms-2 letter-spacing-2">@Model.CaseNumber</b></h5>
				<h5>Fullname: <b class="ms-2">@Model.Fullname</b></h5>
				<h5>Service Partner:  <b class="ms-2">@Model.ServicePartner</b></h5>
				<a class="btn bg-gradient-primary w-auto px-5 mt-4" target="_blank" href="@Model.CaseTrackingLink">View My Case</a>
			</div>
		</div>
	</div>
</div>
