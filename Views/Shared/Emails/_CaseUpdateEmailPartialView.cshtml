													Serial Number:<strong style="margin-left: 0.6em;">{{ SerialNumber }}</strong>
												</p>
											</div>

											<div>
												<a href="{{ CaseTrackingLink }}" target="_blank" style="
                        display: inline-block;
                        background-color: #cb0c9f;
                        color: #ffffff;
                        font-family: Arial, sans-serif;
                        font-size: 14px;
                        font-weight: bold;
                        text-decoration: none;
                        padding: 10px 40px;
                        border-radius: 5px;
												box-shadow: 0 4px 7px -1px rgba(0, 0, 0, 0.11), 0 2px 4px -1px rgba(0, 0, 0, 0.07);
											">
													View Case
												</a>
											</div>
										</td>
									</tr>

									<tr>
										<td>
											<div>
												<p style="margin-top: 40px;">
													If any additional information is required, we will reach out to you.
												</p>
											</div>
										</td>
									</tr>
								</tbody>
							</table>
						</td>
					</tr>
					<!--Footer-->
					<tr>
						<td align="center" style="font-size: 16px; color: #999999; font-family: Arial, sans-serif; padding-top: 30px;">
							This is an automated message – please do not reply.
						</td>
					</tr>
					<tr>
						<td>
							<br />
							<br />
							<br />
						</td>
					</tr>

				</table>
			</td>
		</tr>
	</table>
</div>