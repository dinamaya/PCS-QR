@using CCIMS.Web.App_Code._Globals.Constants

@{
	string _role = User.GetIdentityClaim(AuthClaims.ROLE);
	string GetLink(long caseId, string caseNumber) => _role.Equals("SPA") ? $"/Cases/Update/{caseId}" : $"/Cases/Tracking?refNo={caseNumber}";

	ViewData[Keys.ViewData.TITLE] = "Dashboard";
}
<main>
	<div class="container-fluid py-4">
		<div class="row">
			<div class="col-lg-12 position-relative z-index-2">
				<div class="row">
					<div class="col-lg-3 col-md-6 mb-4">
						<div class="card">
							<div class="card-body p-3">
								<div class="row">
									<div class="col-8">
										<div class="numbers">
											<p class="text-sm mb-0 text-capitalize font-weight-bold">Today's Cases</p>
											<h5 class="font-weight-bolder mb-0">
												@ViewBag.CasesCreatedToday
											</h5>
										</div>
									</div>
									<div class="col-4 text-end">
										<div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
											<i class="fas fa-calendar-day text-lg opacity-10" aria-hidden="true"></i>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-6 mb-4">
						<div class="card">
							<div class="card-body p-3">
								<div class="row">
									<div class="col-8">
										<div class="numbers">
											<p class="text-sm mb-0 text-capitalize font-weight-bold">Aging Cases 3+ days</p>
											<h5 class="font-weight-bolder mb-0">
												@ViewBag.AgingCasesCount
											</h5>
										</div>
									</div>
									<div class="col-4 text-end">
										<div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
											<i class="fas fa-hourglass-end text-lg opacity-10" aria-hidden="true"></i>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-6 mb-4">
						<div class="card">
							<div class="card-body p-3">
								<div class="row">
									<div class="col-8">
										<div class="numbers">
											<p class="text-sm mb-0 text-capitalize font-weight-bold">Closed Cases</p>
											<h5 class="font-weight-bolder mb-0">
												@ViewBag.ClosedCasesCount
											</h5>
										</div>
									</div>
									<div class="col-4 text-end">
										<div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
											<i class="fas fa-calendar-check text-lg opacity-10" aria-hidden="true"></i>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-6 mb-4">
						<div class="card">
							<div class="card-body p-3">
								<div class="row">
									<div class="col-8">
										<div class="numbers">
											<p class="text-sm mb-0 text-capitalize font-weight-bold">Total Cases</p>
											<h5 class="font-weight-bolder mb-0">
												@ViewBag.TotalCasesCount
											</h5>
										</div>
									</div>
									<div class="col-4 text-end">
										<div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
											<i class="fas fa-cubes text-lg opacity-10" aria-hidden="true"></i>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row mt-4">
			<div class="col-lg-4 col-sm-6 mb-4">
				<div class="card">
					<div class="card-header p-3 pb-0">
						<h6 class="mb-0">Latest Case Submissions</h6>
					</div>
					<div class="card-body border-radius-lg p-3">
						@if (ViewBag.LatestCaseSubmission != null && ViewBag.LatestCaseSubmission.Count > 0)
						{
							int counter = 1;
							@foreach (var caseItem in ViewBag.LatestCaseSubmission)
							{
								<div class="d-flex @(counter > 1 ? "mt-2" : "")">
									<div>
										<div class="icon icon-shape bg-info-soft shadow text-center border-radius-md shadow-none d-flex align-items-center justify-content-center">
											<span class="text-lg text-info text-gradient opacity-10">@counter</span>
										</div>
									</div>
									<div class="ms-3">
										<div class="numbers">
											<h6 class="mb-0 text-dark text-sm">
												<a href="@GetLink(caseItem.CaseId, caseItem.CaseNumber)" class="text-dark" style="text-decoration: none; display: inline-block;">
													<span style="cursor: pointer; font-weight: bold;" onmouseover="this.style.color='#0d6efd'; " onmouseout="this.style.color='inherit';">@caseItem.LastName, @caseItem.FirstName</span>
												</a>
											</h6>
											<span class="text-sm">@caseItem.DateCreated.ToString("dd MMMM yyyy, 'at' h:mm tt")</span>
										</div>
									</div>
								</div>
								counter++;
							}
						}
						else
						{
							<div class="text-center py-3">
								<p class="text-sm text-muted">No recent case submissions found.</p>
							</div>
						}
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-sm-6 mb-4">
				<div class="card">
					<div class="card-header p-3 pb-0">
						<h6 class="mb-0">Top Service Partners with Aging Cases</h6>
					</div>
					<div class="card-body border-radius-lg p-3">
						@if (ViewBag.Top3ServicePartnersAgingCases != null && ViewBag.Top3ServicePartnersAgingCases.Count > 0)
						{
							int counter = 1;
							@foreach (var caseItem in ViewBag.Top3ServicePartnersAgingCases)
							{
								<div class="d-flex @(counter > 1 ? "mt-2" : "")">
									<div>
										<div class="icon icon-shape bg-info-soft shadow text-center border-radius-md shadow-none d-flex align-items-center justify-content-center">
											<span class="text-lg text-info text-gradient opacity-10">@counter</span>
										</div>
									</div>
									<div class="ms-3">
										<div class="numbers">
											<h6 class="mb-0 text-dark text-sm">
												@if (_role.Equals("SPA"))
												{
													<a href="/CMS/Cases?d=@caseItem.ServicePartnerName" class="text-dark" style="text-decoration: none; display: inline-block;">
														<span style="cursor: pointer; font-weight: bold;" onmouseover="this.style.color='#0d6efd'; " onmouseout="this.style.color='inherit';">@caseItem.ServicePartnerName</span>
													</a>
												}
												else
												{
													<span class="text-dark" style="text-decoration: none; display: inline-block;">
														<span style="font-weight: bold;">@caseItem.ServicePartnerName</span>
													</span>
												}

											</h6>
											<span class="text-sm">Cases: @caseItem.AgingCaseCount</span>
										</div>
									</div>
								</div>
								counter++;
							}
						}
						else
						{
							<div class="text-center py-3">
								<p class="text-sm text-muted">All cases are up to date. No aging issues detected.</p>
							</div>
						}
					</div>
				</div>
			</div>
			<div class="col-lg-4 col-sm-12 mb-4">
				<div class="card">
					<div class="card-header p-3 pb-0">
						<h6 class="mb-0">Top Aging Cases</h6>
					</div>
					<div class="card-body border-radius-lg p-3">
						@if (ViewBag.TopAgingCases != null && ViewBag.TopAgingCases.Count > 0)
						{
							int counter = 1;
							@foreach (var caseItem in ViewBag.TopAgingCases)
							{
								<div class="d-flex @(counter > 1 ? "mt-2" : "")">
									<div>
										<div class="icon icon-shape bg-info-soft shadow text-center border-radius-md shadow-none d-flex align-items-center justify-content-center">
											<span class="text-lg text-info text-gradient opacity-10">@counter</span>
										</div>
									</div>
									<div class="ms-3">
										<div class="numbers">
											<h6 class="mb-0 text-dark text-sm">
												<a href="@GetLink(caseItem.CaseId, caseItem.CaseNumber)" class="text-dark" style="text-decoration: none; display: inline-block;">
													<span style="cursor: pointer; font-weight: bold;" onmouseover="this.style.color='#0d6efd'; " onmouseout="this.style.color='inherit';">@caseItem.LastName, @caseItem.FirstName</span>
												</a>
											</h6>
											<span class="text-sm">Days: @caseItem.NumberOfDays</span>
										</div>
									</div>
								</div>
								counter++;
							}
						}
						else
						{
							<div class="text-center py-3">
								<p class="text-sm text-muted">All cases are up to date—no aging issues!.</p>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
		<div class="row mt-4">
			<div class="col-lg-12 col-md-12">
				<div class="card z-index-2">
					<div class="card-header p-3 pb-0">
						<h6>Daily Created Cases Over the Week</h6>
					</div>
					<div class="card-body p-3">
						<div class="chart">
							<canvas id="daily-cases" class="chart-canvas" height="300"></canvas>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-12 col-md-12 mt-4">
				<div class="card z-index-2">
					<div class="card-header p-3 pb-0">
						<h6>Daily Closed Cases Over the Week</h6>
					</div>
					<div class="card-body p-3">
						<div class="chart">
							<canvas id="daily-closed" class="chart-canvas" height="300"></canvas>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</main>
<!-- Kanban scripts -->
<script src="~/js/plugins/dragula/dragula.min.js"></script>
<script src="~/js/plugins/jkanban/jkanban.js"></script>
<script src="~/js/plugins/chartjs.min.js"></script>
<script src="~/js/plugins/threejs.js"></script>
<script src="~/js/plugins/orbit-controls.js"></script>

<script>

	// For Weekly Cases Chart
	var weeklyCasesData = @Html.Raw(Json.Serialize(ViewBag.WeeklyCasesChart));
	var labels = weeklyCasesData.map(function (item) {
			// Format: "DayOfWeek (MM-DD)"
			var caseDate = new Date(item.caseDate);
			var month = String(caseDate.getMonth() + 1).padStart(2, '0');
			var day = String(caseDate.getDate()).padStart(2, '0');
			return item.dayOfWeek + " (" + month + "-" + day + ")";
	});
	var caseCounts = weeklyCasesData.map(function (item) {
			return item.totalCases;
	});

	//For Weekly Closed Cases Chart
	var weeklyClosedData = @Html.Raw(Json.Serialize(ViewBag.WeeklyClosedCasesChart));

	var closedLabels = weeklyClosedData.map(function (item) {
			// Format: "DayOfWeek (MM-DD)"
			var caseDate = new Date(item.caseDate);
			var month = String(caseDate.getMonth() + 1).padStart(2, '0');
			var day = String(caseDate.getDate()).padStart(2, '0');
			return item.dayOfWeek + " (" + month + "-" + day + ")";
	});
	var closedCounts = weeklyClosedData.map(function (item) {
		return item.totalClosedCases;
	});;

	// Line chart setup

	var dailyCasesChart = document.getElementById("daily-cases").getContext("2d");
	var ctx2 = document.getElementById("daily-cases").getContext("2d");

	var weeklyClosedChart = document.getElementById("daily-closed").getContext("2d");

	var gradientStroke1 = ctx2.createLinearGradient(0, 230, 0, 50);

	gradientStroke1.addColorStop(1, 'rgba(203,12,159,0.2)');
	gradientStroke1.addColorStop(0.2, 'rgba(72,72,176,0.0)');
	gradientStroke1.addColorStop(0, 'rgba(203,12,159,0)');

	var gradientStroke2 = ctx2.createLinearGradient(0, 230, 0, 50);

	gradientStroke2.addColorStop(1, 'rgba(20,23,39,0.2)');
	gradientStroke2.addColorStop(0.2, 'rgba(72,72,176,0.0)');
	gradientStroke2.addColorStop(0, 'rgba(20,23,39,0)');


	// Weekly Cases chart with data from database
	new Chart(dailyCasesChart, {
			type: "line",
			data: {
					labels: labels,
					datasets: [{
							label: "Cases",
							tension: 0.4,
							borderWidth: 0,
							pointRadius: 2,
							pointBackgroundColor: "#D53333",
							borderColor: "#D53333",
							borderWidth: 3,
							backgroundColor: gradientStroke1,
							data: caseCounts,
							maxBarThickness: 6
					}],
			},
			options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: {
							legend: {
									display: false,
							}
					},
					interaction: {
							intersect: false,
							mode: 'index',
					},
					scales: {
							y: {
									grid: {
											drawBorder: false,
											display: true,
											drawOnChartArea: true,
											drawTicks: false,
											borderDash: [5, 5]
									},
									ticks: {
											display: true,
											padding: 10,
											color: '#b2b9bf',
											font: {
													size: 11,
													family: "Open Sans",
													style: 'normal',
													lineHeight: 2
											},
											min: 0,
											// Calculate max based on data for better visualization
											max: Math.max(...caseCounts) + 10 - (Math.max(...caseCounts) % 10),
											stepSize: 10,
									}
							},
							x: {
									grid: {
											drawBorder: false,
											display: true,
											drawOnChartArea: true,
											drawTicks: true,
											borderDash: [5, 5]
									},
									ticks: {
											display: true,
											color: '#b2b9bf',
											padding: 10,
											font: {
													size: 11,
													family: "Open Sans",
													style: 'normal',
													lineHeight: 2
											},
									}
							},
					},
			},
	});

	// Weekly Closed

	new Chart(weeklyClosedChart, {
			type: "line",
			data: {
					labels: labels,
					datasets: [{
							label: "Cases",
							tension: 0.4,
							borderWidth: 0,
							pointRadius: 2,
							pointBackgroundColor: "#D53333",
							borderColor: "#D53333",
							borderWidth: 3,
							backgroundColor: gradientStroke1,
				data: closedCounts,
							maxBarThickness: 6
					}],
			},
			options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: {
							legend: {
									display: false,
							}
					},
					interaction: {
							intersect: false,
							mode: 'index',
					},
					scales: {
							y: {
									grid: {
											drawBorder: false,
											display: true,
											drawOnChartArea: true,
											drawTicks: false,
											borderDash: [5, 5]
									},
									ticks: {
											display: true,
											padding: 10,
											color: '#b2b9bf',
											font: {
													size: 11,
													family: "Open Sans",
													style: 'normal',
													lineHeight: 2
											},
											min: 0,
											// Calculate max based on data for better visualization
											max: Math.max(...closedCounts) + 10 - (Math.max(...closedCounts) % 10),
											stepSize: 10,
									}
							},
							x: {
									grid: {
											drawBorder: false,
											display: true,
											drawOnChartArea: true,
											drawTicks: true,
											borderDash: [5, 5]
									},
									ticks: {
											display: true,
											color: '#b2b9bf',
											padding: 10,
											font: {
													size: 11,
													family: "Open Sans",
													style: 'normal',
													lineHeight: 2
											},
									}
							},
					},
			},
	});
</script>
