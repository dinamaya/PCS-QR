@using CCIMS.Web.App_Code._Globals
@using CCIMS.Web.App_Code._Globals.Constants
@using CCIMS.Web.App_Code._Globals.Extensions
@using CCIMS.Web.Models.ViewModels
@using CCIMS.Web.Models.ViewModels.Partials

@model string
@inject IConfiguration Configuration

@{
	ViewData[Keys.ViewData.TITLE] = "Case Tracking";

	var adminDomain = Configuration["SubdomainConfig:Admin"];
	var externalDomain = Configuration["SubdomainConfig:External"];
	var loginUrl = $"https://{adminDomain}.vstecs.com.ph/Auth/Login";
	var currentHost = Context.Request.Host.Host;
	var isExternal = currentHost.StartsWith(externalDomain);
	var _user = User.Identities.FirstOrDefault();

	var _case = (CaseDetailsViewModel)ViewData[Keys.ViewData.CASE];
	var caseNumber = new InputFieldViewModel()
			{
				IdName = "textVal",
				Title = "Case Number",
				ClassName = "col mx-2 mb-2 ",
				InputClassName = "border-0",
				IsLabelVisible = false,
				IsCompact = true,
				Value = Model ?? _case?.CaseNumber ?? "",
				AspName = "refNo"
			};

	var customer = (CustomerDetailsViewModel)ViewData[Keys.ViewData.CUSTOMER];
	var transactions = (IEnumerable<CaseTransactionsViewModel>)ViewData[Keys.ViewData.TRANSACTIONS];

	string avatar = customer != null ? customer.Firstname.ElementAt(0).ToString().ToUpper() + customer?.Lastname.ElementAt(0).ToString().ToUpper() : " ";

}

<div class="container-fluid py-4">
	<div class="row">
		<div class="col-12">
			<div class="card mb-4">
				<div class="card-header pb-0">
					<div class="d-lg-flex">
						<div class="w-100 w-lg-40">
							<h6 class="mb-0">Case Tracking</h6>
							<p class="text-sm mb-0">
								Search for a registered case using its case number / ID.
							</p>
						</div>
						<div class="ms-lg-auto my-auto mt-lg-0 mt-4 col-12 col-lg-8">
							<form id="form-track-case">
								<div class="d-sm-block d-lg-flex">
									<div class="col">
										@await Html.PartialAsync(Routes.Partials.Inputs.TEXTBOX, caseNumber)
									</div>

									<div class="col-12 col-lg-4 h-auto">
										<div class="px-2 d-flex mx-2 pb-2 h-100 justify-content-center align-content-center">
											<button type="submit" class="w-100 h-auto btn bg-gradient-primary btn-sm mb-0" id="btn-search">
												Search
											</button>
										</div>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
				<div class="card-body px-0 pt-0 pb-2">
					<div class="container">
						<div class="tab-content tab-space">
							<div class="tab-pane active" id="monthly">
								<div class="row">

									@if (customer != null && transactions != null)
									{
										<div class="mb-0 col-12 col-lg-5">
											<div class="card blur  shadow-blur overflow-auto overflow-x-hidden mb-4 mb-lg-0">
												<div class="card-header pb-2">
													<h6>Transactions Timeline</h6>
												</div>
												<div class="card-body p-3">
													@(await Html.PartialAsync(Routes.Partials.TIMELINE_TRANSACTIONS, transactions))
												</div>
											</div>
										</div>
										<div class="mb-4 col-12 col-lg-7">
											<div class="mb-4">
												<div class="card shadow-blur max-height-vh-70">
													<div class="card-header">
														<div class="row">
															<div class="d-flex align-items-center">
																<div class="icon icon-shape bg-gradient-primary shadow text-center align-middle border-radius-md d-flex justify-content-center align-items-center">
																	<div style="letter-spacing: 3px;" class="text-white fs-5">
																		@avatar
																	</div>
																</div>

																<div class="ms-3">
																	<h6 class="mb-0 d-block">Customer Details</h6>
																	<span class="text-sm text-dark opacity-8">@Utils.GetTimestamp("Date created ", customer.DateCreated)</span>
																</div>
															</div>
														</div>
													</div>

													<div class="card-body overflow-auto overflow-x-hidden pt-0 pb-3">
														<div class="row border-0 d-flex p-3 bg-gray-100 border-radius-md">
															<div class="col-12 col-lg-6">
																<div class="mb-2 text-sm">Name: <span class="text-dark font-weight-bold ms-2">@(customer.Firstname + " " + customer.Lastname)</span></div>
																<div class="mb-2 text-sm">Address: <span class="text-dark ms-2 font-weight-bold">@customer.Address</span></div>
															</div>
															<div class="col-12 col-lg-6">
																<div class="mb-2 text-sm">Email: <span class="text-dark font-weight-bold ms-2">@customer.Email</span></div>
																<div class="mb-2 text-sm">Contact No: <span class="text-dark ms-2 font-weight-bold">@customer.ContactNo</span></div>
															</div>
														</div>
													</div>
												</div>

											</div>

											<div class="mb-4">
												<div class="card shadow-blur max-height-vh-70">
													<div class="card-header">
														<div class="row">
															<div class="col-md-10">
																<div class="d-flex align-items-center">
																	<div class="icon icon-shape bg-gradient-dark shadow text-center border-radius-md">
																		<i class="ni ni-credit-card text-lg opacity-10" aria-hidden="true"></i>
																	</div>
																	<div class="ms-3">
																		<h6 class="mb-0 d-block">Case Details</h6>
																		<span class="text-sm text-dark opacity-8">@Utils.GetTimestamp("Date issued ", _case.DateCreated)</span>
																	</div>
																</div>
															</div>
														</div>
													</div>

													<div class="card-body overflow-auto overflow-x-hidden pt-0 pb-3">
														<div class="row border-0 d-flex p-3 bg-gray-100 border-radius-md">
															<div class="cl-12 mb-2 text-sm">Case Number / ID: <span class="text-dark font-weight-bold ms-2">@(_case.CaseNumber)</span></div>
															<div class="col-12 col-lg-6">
																<div class="mb-2 text-sm">Serial Number: <span class="text-dark ms-2 font-weight-bold">@_case.SerialNumber</span></div>
															</div>
															<div class="col-12 col-lg-6">
																<div class="mb-2 text-sm">Service Partner: <span class="text-dark ms-2 font-weight-bold">@_case.ServicePartner</span></div>
															</div>
														</div>
													</div>
												</div>

											</div>
										</div>
									}

									@if (!string.IsNullOrEmpty((string)ViewData[Keys.ViewData.ERROR]))
									{
										<div class="mb-4">
											<div class="card shadow-blur max-height-vh-70">
												<div class="card-body">
													<div class="row">
														<div class="d-flex align-items-center">
															<div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md">
																<i class="fa-solid fa-triangle-exclamation text-lg opacity-10" aria-hidden="true"></i>
															</div>

															<div class="ms-3">
																<h6 class="mb-0 d-block">@((string)ViewData[Keys.ViewData.ERROR])</h6>
															</div>
														</div>
													</div>
												</div>
											</div>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


<div class="py-5"></div>

<script>
		$('#form-track-case').submit(function (event) {
			event.preventDefault();
			const trackingPageUrl = '@Url.Action("TrackingInternal", "Cases")';
			const caseNumber = $('#@caseNumber.Id').val();

			$.ajax({
					url: `@Url.Content("/api/secure/enc/case-ref-no")?caseNumber=${caseNumber}`,
					type: 'GET',
					success: function (response) {
						const redirectUrl = `${trackingPageUrl}?refNo=${response}`;
						window.location.href = redirectUrl;
					},
					error: function (xhr, status, error) {
					}
			});
	});

</script>
