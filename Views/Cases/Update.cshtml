@using CCIMS.Web.App_Code._Globals.Constants
@using CCIMS.Web.Models.ViewModels
@using System.Globalization;
@using Humanizer;

@model CaseDetailsViewModel

@{
  var customer = (CustomerDetailsViewModel) ViewData[Keys.ViewData.CUSTOMER];
  var transactions = (IEnumerable<CaseTransactionsViewModel>)ViewData[Keys.ViewData.TRANSACTIONS];
  var _case = (CaseDetailsViewModel)ViewData[Keys.ViewData.CASE];
  
  string avatar = customer.Firstname.ElementAt(0).ToString().ToUpper() + customer.Lastname.ElementAt(0).ToString().ToUpper();
  string name = customer.Firstname.ElementAt(0).ToString().ToUpper() + customer.Lastname.ElementAt(0).ToString().ToUpper();
}
<div class="container-fluid">
  <div class="page-header min-height-300 border-radius-xl mt-4" style="background-image: url('/img/curved-images/curved0.jpg'); background-position-y: 50%;">
    <span class="mask bg-gradient-primary opacity-6"></span>
  </div>
  
  <div class="card card-body blur shadow-blur mx-4 mt-n6 overflow-hidden">
    <div class="row gx-4">
      <div class="col-auto">
        <span style="letter-spacing: 4px" class="avatar avatar-xl me-3 text-black bg-primary fs-2">
          @avatar
        </span>
      </div>
      <div class="col my-auto">
        <div class="h-100">
          <h5 class="mb-1">
            @((customer.Firstname + " " + customer.Lastname).Humanize(LetterCasing.Title))
          </h5>
          <div class="d-flex flex-md-row flex-column">
            <div class="mb-0 font-weight-bold text-sm">
              <span class="me-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope-fill" viewBox="0 0 16 16">
                  <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z" />
                </svg>
              </span>
              <span>
                @customer.Email
              </span>
            </div>
            <div class="ms-0 ms-md-3 mb-0 font-weight-bold text-sm">
              <span class="me-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone-fill" viewBox="0 0 16 16">
                  <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z" />
                </svg>
              </span>
              <span>
                @customer.ContactNo
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xl-2 col-md-3 col-sm-4 col-12 my-sm-auto ms-sm-auto me-sm-0 mx-auto mt-3">
        <div class="nav-wrapper position-relative end-0">
          <ul class="nav nav-pills nav-fill p-1 bg-transparent" role="tablist">
            <li class="nav-item">
              <a class="nav-link mb-0 px-0 py-1 active " data-bs-toggle="tab" href="javascript:;" role="tab" aria-selected="true">
