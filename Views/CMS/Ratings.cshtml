@using CCIMS.Web.App_Code._Globals.Constants
@using CCIMS.Web.App_Code._Globals.Extensions
@using CCIMS.Web.Models.ViewModels
@model IEnumerable<RatingRowViewModel>

<script src="~/js/plugins/datatables.js"></script>
<script src="~/js/plugins/choices.min.js"></script>
@{
    ViewData[Keys.ViewData.TITLE] = "CMS | Ratings";
}

@Html.AntiForgeryToken()

<style>
    .comment-cell {
        max-width: 200px; /* Adjust width as needed */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer; /* Indicates the cell is hoverable */
    }
</style>

<div id="page-spinner" class="d-flex justify-content-center align-items-center position-fixed top-50 start-50 translate-middle text-center" style="z-index: 1060; width:100%; height:100%; background-color: rgba(0,0,0,0.1);">
    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div>
    <div class="container-fluid py-4">
        <div class="mt-3">
            @(await Html.RenderAlertsAsync(success: (string)ViewData[Keys.ViewData.SUCCESS], error: (string)ViewData[Keys.ViewData.ERROR]))
        </div>

        @if (Model != null)
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <!-- Card header -->
                        <div class="card-header pb-0">
                            <div class="d-lg-flex">
                                <div>
                                    <h5 class="mb-0">All Ratings</h5>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="table-responsive">
                                <table class="table table-flush" id="tbl">
                                    <thead>
                                        <tr>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Action</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">CaseNumber</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Rating</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Comment</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Customer Name</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Service Partner Name</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Serial Number</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Date Created</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var row in Model)
                                        {
                                            <tr>
                                                <td class="text-sm font-weight-normal d-flex justify-content-center align-items-center" ">
                                                    <a href="@Url.Action("Update", "Cases", new { id = row.CaseId })" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" data-bs-original-title="Preview product">
                                                        View
                                                    </a>
                                                </td>
                                                <td class="text-sm font-weight-normal">@row.CaseNumber</td>
                                                <td class="text-sm font-weight-normal" data-sort="@row.RatingVal">
                                                    <span style="display:none;">@row.RatingVal</span>
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= row.RatingVal)
                                                        {
                                                            <i class="fa-solid fa-star" style="color: #FFD43B;"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa-solid fa-star" style="color: #E0E0E0;"></i>
                                                        }
                                                    }
                                                </td>
                                                <td class="text-sm font-weight-normal comment-cell" title="@row.Comment">@row.Comment</td>
                                                <td class="text-sm font-weight-normal">@row.CustomerName</td>
                                                <td class="text-sm font-weight-normal">@row.ServicePartnerName</td>
                                                <td class="text-sm font-weight-normal">@row.SerialNumber</td>
                                                <td class="text-sm font-weight-normal">@row.DateCreated.ToString("yyyy-MM-dd hh:mm tt")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row py-5 mt-5">
                <div class="col-12 py-5">
                </div>
            </div>
        }
    </div>
</div>

<script>
    function showPageSpinner() {
        document.getElementById('page-spinner').classList.remove('d-none');
    }

    function hidePageSpinner() {
        document.getElementById('page-spinner').classList.add('d-none');
    }

    // Show spinner initially
    showPageSpinner();

    document.addEventListener('DOMContentLoaded', function () {
    try {
            if (document.getElementById('tbl')) {
        const dataTableSearch = new simpleDatatables.DataTable("#tbl", {
            searchable: true,
                    fixedHeight: true,
                    perPage: 10 // Default items per page
        });
                setTimeout(hidePageSpinner, 100);
            } else {
                hidePageSpinner();
            }
    }
    catch (e) {
            console.log("Datatable not found or error initializing:", e);
            hidePageSpinner();
        }
    });
</script>

