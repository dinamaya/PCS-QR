@using CCIMS.Web.App_Code._Globals.Constants
@using CCIMS.Web.App_Code._Globals.Extensions
@using CCIMS.Web.Models.ViewModels
@model IEnumerable<CaseRowViewModel>

<script src="~/js/plugins/datatables.js"></script>
<script src="~/js/plugins/choices.min.js"></script>
@{
    ViewData[Keys.ViewData.TITLE] = "CMS | Cases";
}

@Html.AntiForgeryToken()

<div id="page-spinner" class="d-flex justify-content-center align-items-center position-fixed top-50 start-50 translate-middle text-center" style="z-index: 1060; width:100%; height:100%; background-color: rgba(0,0,0,0.1);">
    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div>
    <div class="container-fluid py-4">
        <div class="row mb-5">
            @await Html.PartialAsync(Routes.Partials.Cases.SEARCH)
        </div>
        <div class="mt-3">
          @(await Html.RenderAlertsAsync(success: (string)ViewData[Keys.ViewData.SUCCESS], error: (string)ViewData[Keys.ViewData.ERROR]))
        </div>

        @if (Model != null)
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <!-- Card header -->
                        <div class="card-header pb-0">
                            <div class="d-lg-flex">
                                <div>
                                    <h5 class="mb-0">All Cases</h5>
                                </div>
                                <div class="ms-auto my-auto mt-4">
                                    <div class="ms-auto my-auto">
                                        <button id="btnExportExcel" class="btn btn-outline-primary btn-sm export mb-0 mt-sm-0 mt-1" type="button" name="button">Export</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-body px-0 pb-0">
                            <div class="table-responsive">
                                <table class="table table-flush" id="tbl">
                                    <thead>
                                        <tr>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Edit</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">CaseNumber</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Status</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Comments / Remarks</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Customer Name</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Service Partner Name</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Serial Number</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Date Created</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Date Updated</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Updated By</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Days Aged</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var row in Model)
                                        {
                                            @await Html.PartialAsync(Routes.Partials.Cases.TROW, row)
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row py-5 mt-5">
                <div class="col-12 py-5">
                </div>
            </div>
        }
    </div>
</div>

@(await Html.PartialAsync(Routes.Partials.Cases.STAT_UPDATE_MODAL))
<script src="~/js/components/casesExport.js"></script>
<script>
    window.baseUrl = '@Url.Content("/api/cases")'

    function showPageSpinner() {
        document.getElementById('page-spinner').classList.remove('d-none');
        // document.getElementById('page-overlay').classList.remove('d-none');
    }

    function hidePageSpinner() {
        document.getElementById('page-spinner').classList.add('d-none');
        // document.getElementById('page-overlay').classList.add('d-none');
    }

    // Show spinner initially
    showPageSpinner();

    document.addEventListener('DOMContentLoaded', function () {
    try {
            if (document.getElementById('tbl')) {
        const dataTableSearch = new simpleDatatables.DataTable("#tbl", {
            searchable: true,
                    fixedHeight: true,
                    perPage: 10 // Default items per page
        });
                // Hide spinner once DataTable is initialized (or after a short delay to ensure rendering)
                setTimeout(hidePageSpinner, 100); // Adjust delay as needed
            } else {
                // If table is not present (e.g. Model is null or empty), hide spinner
                hidePageSpinner();
            }
    }
    catch (e) {
            console.log("Datatable not found or error initializing:", e);
            hidePageSpinner(); // Hide spinner on error too
        }

        // If there's a search form, attach spinner logic to its submission
        const searchForm = document.querySelector('@CCIMS.Web.App_Code._Globals.Constants.Routes.Partials.Cases.SEARCH form'); // Assuming the search partial has a form
        if (searchForm) {
            searchForm.addEventListener('submit', function() {
                showPageSpinner();
                // Spinner will be hidden by DOMContentLoaded on next page load, or if it's an AJAX search, by its success/error handler
            });
    }
    });
</script>

