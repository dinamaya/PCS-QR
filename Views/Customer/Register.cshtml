@model CCIMS.Web.Models.DTOs.CreateCustomerDto

@{
	ViewData["Title"] = "Customer Form";
	Layout = "~/Views/Shared/_PublicLayout.cshtml"; 
}


<div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg" style="background-image: url('/img/curved-images/curved9.jpg');" );">
	<span class="mask bg-gradient-dark opacity-6"></span>
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-lg-5 text-center mx-auto">
				<h1 class="text-white mb-2 mt-5">Welcome!</h1>
				<p class="text-lead text-white">Create a new case.</p>
			</div>
		</div>
	</div>
</div>
<div class="container-fluid py-4">
	<div class="row mt-lg-n12 mt-md-n13 mt-n12 justify-content-center">
		<div class="col-12">
			<div class="mb-5">
				<!--form panels-->
				<div class="row">
					<div class="col-12 col-lg-8 m-auto">
						<!--single form panel-->
						<div class="card p-3 border-radius-xl bg-white mb-5">
							<h5 class="font-weight-bolder mb-0">Customer Case Form</h5>
							<p class="mb-0 text-sm">Please provide your details to help us process your case efficiently.</p>

							@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
							{
								<div class="alert alert-warning" role="alert">
									@ViewBag.ErrorMessage
								</div>
							}

							<form method="post" action="@Url.Action("Register", "Customer", new { token = Model.Token })" id="customerForm">
								@Html.AntiForgeryToken()
								<input type="text" name="Token" value="@Context.Request.Query["token"]" />
								<div class="row mt-3">
									<div class="col-12 col-sm-6">
										<label>First Name</label>
										<input class="form-control" type="text" asp-for="FirstName" required />
										<span asp-validation-for="FirstName" class="text-danger"></span>
									</div>
									<div class="col-12 col-sm-6 mt-3 mt-sm-0">
										<label>Last Name</label>
										<input class="form-control" type="text" asp-for="LastName" required />
										<span asp-validation-for="LastName" class="text-danger"></span>
									</div>
								</div>
								<div class="row mt-3">
									<div class="col-12 col-sm-6">
										<label>Contact Number</label>
										<input class="form-control" type="text" asp-for="ContactNumber" required />
										<span asp-validation-for="ContactNumber" class="text-danger"></span>
									</div>
									<div class="col-12 col-sm-6 mt-3 mt-sm-0">
										<label>Email Address</label>
										<input class="form-control" type="email" asp-for="Email" required />
										<span asp-validation-for="Email" class="text-danger"></span>
									</div>
								</div>
								<div class="row mt-3">
									<div class="col">
										<label>Address</label>
										<input class="form-control" type="text" asp-for="Address" required />
										<span asp-validation-for="Address" class="text-danger"></span>
									</div>
								</div>							
								<div class="row mt-3">
									<div class="col-12 col-sm-6 mt-3 mt-sm-0">
										<label>Serial Number</label>
										<input class="form-control" type="text" asp-for="SerialNumber" required />
										<span asp-validation-for="SerialNumber" class="text-danger"></span>
									</div>
								</div>

								<!-- Privacy Policy Checkbox -->
								<div class="row mt-4">
									<div class="col-12">
										<div class="form-check">
											<input class="form-check-input" type="checkbox" id="privacyPolicyCheckbox" asp-for="PrivacyPolicyAccepted" required>
											<label class="form-check-label" for="privacyPolicyCheckbox">
												I agree to let VST ECS process my personal data in order to manage my case submission, in accordance with
												<a href="#" data-bs-toggle="modal" data-bs-target="#privacyPolicyModal" class="text-info">VST ECS Privacy Notice</a>.
											</label>
											<span asp-validation-for="PrivacyPolicyAccepted" class="text-danger"></span>
										</div>
									</div>
								</div>

								<div class="text-left mt-4">
									<button class="btn bg-gradient-dark ms-auto mb-0" type="submit" title="Send">Submit</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Privacy Policy Modal -->
<div class="modal fade" id="privacyPolicyModal" tabindex="-1" aria-labelledby="privacyPolicyModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="privacyPolicyModalLabel">VST ECS Privacy Notice</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<h6>Privacy Policy</h6>
				<p>
					VST ECS Philippines, Inc. is committed to protecting your privacy and ensuring the security of your personal information. 
					This Privacy Notice explains how we collect, use, disclose, and safeguard your data when you submit a customer case.
				</p>
				
				<h6>Information We Collect</h6>
				<p>
					We collect personal information such as your name, contact details, address, and product information to help us process and manage your case submission effectively. 
					This information is necessary to identify you, communicate with you regarding your case, and provide appropriate support services.
				</p>
				
				<h6>How We Use Your Information</h6>
				<p>We use your personal information to:</p>
				<ul>
					<li>Process and manage your case submission</li>
					<li>Communicate with you about your case status</li>
					<li>Provide customer support and technical assistance</li>
					<li>Improve our products and services</li>
					<li>Comply with legal obligations</li>
				</ul>
				
				<h6>Information Sharing</h6>
				<p>
					We may share your information with service providers who assist us in processing your case. 
					We do not sell or rent your personal information to third parties. 
					Any third party who receives your information is obligated to maintain its confidentiality and security.
				</p>
				
				<h6>Data Security</h6>
				<p>
					We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, 
					alteration, disclosure, or destruction.
				</p>
				
				<h6>Your Rights</h6>
				<p>
					You have the right to access, correct, or delete your personal information. 
					You may also withdraw your consent for the processing of your data, subject to legal or contractual restrictions.
				</p>
				
				<h6>Contact Information</h6>
				<p>
					If you have questions about this Privacy Notice or our data practices, please contact our Data Protection Officer at privacy@vstecs.ph.
				</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn bg-gradient-dark" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>