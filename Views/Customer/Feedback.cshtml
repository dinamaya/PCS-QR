@model CCIMS.Web.Models.ViewModels.FeedbackViewModel
@using CCIMS.Web.App_Code._Globals.Constants
@{
    ViewData[Keys.ViewData.TITLE] = "Customer Feedback";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg" style="background-image: url('/img/curved-images/curved9.jpg');">
    <span class="mask bg-gradient-dark opacity-6"></span>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 text-center mx-auto">
                <h1 class="text-white mb-2 mt-5">We Value Your Feedback!</h1>
                <p class="text-white">Help us improve our service by sharing your experience for case #<b class="fw-bolder"><u>@Model.CaseNumber</u></b>.</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/star-rating.min.css" rel="stylesheet" />
    <link href="~/css/themes/krajee-svg/theme.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/star-rating.min.js"></script>
    <script src="~/js/themes/krajee-svg/theme.js"></script>
    <script>
        // jQuery script for the star rating plugin
        $(document).ready(function () {
            $("#rating-input").rating({
                theme: 'krajee-svg',
                showCaption: false,
                showClear: false
            });
        });

        // JS for the character counter to avoid conflicts
        document.addEventListener('DOMContentLoaded', function () {
            const commentInput = document.getElementById('comment-input');
            const charCounter = document.getElementById('char-counter');

            if (commentInput && charCounter) {
                const maxLength = commentInput.getAttribute('maxlength');

                commentInput.addEventListener('input', function () {
                    const currentLength = this.value.length;
                    const remaining = maxLength - currentLength;

                    charCounter.textContent = remaining + ' characters remaining';

                    if (remaining <= 20) {
                        charCounter.classList.add('text-danger');
                    } else {
                        charCounter.classList.remove('text-danger');
                    }
                });
            }
        });
    </script>
}
<div class="container-fluid py-4">
    <div class="row mt-lg-n12 mt-md-n13 mt-n12 justify-content-center">
        <div class="col-12">
            <div class="mb-5">
                <div class="row">
                    <div class="col-12 col-lg-8 m-auto">
                        <div class="card p-3 border-radius-xl bg-white mb-5">
                            <h5 class="font-weight-bolder mb-0">Feedback Form</h5>
                            <p class="mb-0 text-sm">Please provide your feedback below.</p>

                            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                            {
                                <div class="alert alert-warning" role="alert">
                                    @ViewBag.ErrorMessage
                                </div>
                            }

                            <form method="post" action="@Url.Action("Feedback", "Customer")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Token" />
                                <input type="hidden" asp-for="CaseNumber" />

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <label for="rating-input">Rating</label>
                                        <input id="rating-input" name="Rating" class="rating rating-loading" data-min="0" data-max="5" data-step="1" data-size="sm" required>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <label>Comment</label>
                                        <textarea class="form-control" id="comment-input" asp-for="Comment" rows="5" required maxlength="1500"></textarea>
                                        <div class="d-flex justify-content-end">
                                            <small id="char-counter" class="form-text text-muted">1500 characters remaining</small>
                                        </div>
                                        <span asp-validation-for="Comment" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mt-4 px-2">
                                    <button class="col-12 col-sm-12 col-lg-3 col-xl-2 btn bg-gradient-dark" type="submit" title="Submit Feedback">Submit Feedback</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>