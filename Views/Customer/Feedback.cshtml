@model CCIMS.Web.Models.ViewModels.FeedbackViewModel
@using CCIMS.Web.App_Code._Globals.Constants
@{
    ViewData[Keys.ViewData.TITLE] = "Customer Feedback";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    .rating {
        display: inline-block;
        font-size: 0;
    }

    .rating > input {
        display: none;
    }

    .rating > label {
        font-size: 30px;
        color: #ddd;
        cursor: pointer;
    }

    .rating > input:checked ~ label,
    .rating:not(:checked) > label:hover,
    .rating:not(:checked) > label:hover ~ label {
        color: #f7d106;
    }
</style>

<div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg" style="background-image: url('/img/curved-images/curved9.jpg');">
    <span class="mask bg-gradient-dark opacity-6"></span>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 text-center mx-auto">
                <h1 class="text-white mb-2 mt-5">We Value Your Feedback!</h1>
                <p class="text-white">Help us improve our service by sharing your experience for case #<b class="fw-bolder"><u>@Model.CaseNumber</u></b>.</p>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid py-4">
    <div class="row mt-lg-n12 mt-md-n13 mt-n12 justify-content-center">
        <div class="col-12">
            <div class="mb-5">
                <div class="row">
                    <div class="col-12 col-lg-8 m-auto">
                        <div class="card p-3 border-radius-xl bg-white mb-5">
                            <h5 class="font-weight-bolder mb-0">Feedback Form</h5>
                            <p class="mb-0 text-sm">Please provide your feedback below.</p>

                            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                            {
                                <div class="alert alert-warning" role="alert">
                                    @ViewBag.ErrorMessage
                                </div>
                            }

                            <form method="post" action="@Url.Action("Feedback", "Customer")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Token" />
                                <input type="hidden" asp-for="CaseNumber" />

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <label>Rating</label>
                                        <div class="rating">
                                            <input type="radio" id="star5" name="Rating" value="5" /><label for="star5" title="5 stars">★</label>
                                            <input type="radio" id="star4" name="Rating" value="4" /><label for="star4" title="4 stars">★</label>
                                            <input type="radio" id="star3" name="Rating" value="3" /><label for="star3" title="3 stars">★</label>
                                            <input type="radio" id="star2" name="Rating" value="2" /><label for="star2" title="2 stars">★</label>
                                            <input type="radio" id="star1" name="Rating" value="1" /><label for="star1" title="1 star">★</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <label>Comment</label>
                                        <textarea class="form-control" asp-for="Comment" rows="5" required></textarea>
                                        <span asp-validation-for="Comment" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mt-4 px-2">
                                    <button class="col-12 col-sm-12 col-lg-3 col-xl-2 btn bg-gradient-dark" type="submit" title="Submit Feedback">Submit Feedback</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>